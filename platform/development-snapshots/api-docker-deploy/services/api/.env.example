# services/api local environment
# Copy to .env and fill in from the shared vault. Never commit the real file.

# Fastify
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase (server-side only -- SUPABASE_SERVICE_ROLE_KEY must never reach a client)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_STRICT_MAX=30
RATE_LIMIT_STRICT_WINDOW_MS=60000
