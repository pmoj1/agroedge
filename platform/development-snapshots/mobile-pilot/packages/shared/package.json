{
  "name": "@agroedge/shared",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared contract layer -- OpenAPI spec, generated TS types, generated Dart models.",
  "scripts": {
    "generate:types": "openapi-typescript openapi/openapi.yaml -o types/schema.ts && node scripts/generate-resource-types.mjs",
    "generate:models": "dart run build_runner build --delete-conflicting-outputs && node scripts/generate-dart-resource-exports.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3"
  }
}
